# Copia este archivo a .env y rellena los valores. El .env NUNCA se sube a GitHub.

# Server Configuration
# Genera uno largo y aleatorio, p. ej.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=4000

# Emails que tendrán rol de administrador (separados por comas)
ADMIN_EMAILS=

# Database Configuration
# Postgres. Con Docker, docker-compose ya pone DB_HOST, DB_PORT y DB_USER: basta con DB_PASSWORD.
# Sin Docker (API en local y Postgres en Docker): DB_HOST=localhost, DB_PORT=5433 y DB_USER=postgres
DB_HOST=postgres-db
DB_USER=postgres
DB_PASSWORD=
DB_NAME=astrocodebd
DB_PORT=5432
# En la nube (Supabase) se usa la cadena de conexión en lugar de las DB_* anteriores
# DATABASE_URL=postgresql://...

# Python runner (sin Docker: http://localhost:5000)
PYTHON_RUNNER_URL=http://python-runner:5000

# Orígenes permitidos para CORS (separados por comas)
CORS_ORIGIN=http://localhost:3000

# IA (opcional): API key de https://build.nvidia.com. Sin ella, las pistas y el generador se desactivan
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Pon true para dejar que el modelo razone antes de responder (más lento)
NVIDIA_RAZONAMIENTO=false
PISTAS_POR_DIA=20
