# Copia este archivo a .env y rellena los valores. El .env NUNCA se sube a GitHub.

# Server Configuration
# Genera uno largo y aleatorio, p. ej.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=4000

# Emails que tendrán rol de administrador (separados por comas)
ADMIN_EMAILS=

# Database Configuration
# Con Docker, DB_HOST=mysql-db. Sin Docker (API en local y MySQL en Docker): DB_HOST=localhost y DB_PORT=3307
DB_HOST=mysql-db
DB_USER=root
DB_PASSWORD=
DB_NAME=astrocodebd
DB_PORT=3306

# Python runner (sin Docker: http://localhost:5000)
PYTHON_RUNNER_URL=http://python-runner:5000

# Orígenes permitidos para CORS (separados por comas)
CORS_ORIGIN=http://localhost:3000

# IA (opcional): API key de https://build.nvidia.com. Sin ella, las pistas y el generador se desactivan
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
PISTAS_POR_DIA=20
